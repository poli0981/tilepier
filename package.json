{
	"name": "tilepier",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run clean && wrangler types && vite build",
		"preview": "pnpm run build && wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --local-protocol https",
		"deploy:prod": "pnpm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"gen": "wrangler types",
		"clean": "node -e \"const fs=require('node:fs');fs.rmSync('.svelte-kit/output',{recursive:true,force:true});fs.rmSync('.svelte-kit/cloudflare',{recursive:true,force:true})\"",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "pnpm run i18n:compile && prettier --check . && eslint . && pnpm run check",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright install && playwright test",
		"knip": "knip",
		"budgets": "node scripts/check-budgets.mjs",
		"verify": "pnpm run clean && pnpm run lint && pnpm run knip && pnpm run i18n:check && pnpm run i18n:audit && pnpm run tokens:audit && pnpm run test:cov && pnpm run build && pnpm run budgets",
		"fonts:sync": "node scripts/sync-fonts.mjs",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
		"i18n:check": "node scripts/i18n-check.mjs",
		"i18n:audit": "node scripts/i18n-audit.mjs",
		"tokens:audit": "node scripts/tokens-audit.mjs",
		"test:cov": "vitest run --coverage"
	},
	"dependencies": {
		"dexie": "^4.4.4",
		"dompurify": "^3.4.13",
		"echarts": "^6.1.0",
		"fast-xml-parser": "^5.10.1",
		"gridstack": "^12.6.0",
		"maplibre-gl": "^5.24.0",
		"marked": "^18.0.9",
		"music-metadata": "^11.14.0",
		"qrcode-generator": "^2.0.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/be-vietnam-pro": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.23.2",
		"@inlang/plugin-m-function-matcher": "^2.2.11",
		"@inlang/plugin-message-format": "^4.4.3",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "^6.32.1",
		"msw": "^2.15.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	}
}
