{
	"name": "tilepier",
	"private": true,
	"version": "1.0.1",
	"type": "module",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@11.28.8",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run clean && pnpm run gen && vite build",
		"preview": "pnpm run build && wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --local-protocol https",
		"deploy:prod": "pnpm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"gen": "wrangler types --env-file .dev.vars.example --strict-vars=false",
		"clean": "node -e \"const fs=require('node:fs');fs.rmSync('.svelte-kit/output',{recursive:true,force:true});fs.rmSync('.svelte-kit/cloudflare',{recursive:true,force:true});fs.rmSync('.svelte-kit/tp-shipped',{recursive:true,force:true})\"",
		"check": "pnpm run gen --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm run typecheck",
		"typecheck": "tsc --noEmit",
		"lint": "pnpm run i18n:compile && prettier --check . && eslint . && pnpm run check",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright install chromium && playwright test",
		"knip": "knip",
		"budgets": "node scripts/check-budgets.mjs",
		"verify": "pnpm run clean && pnpm run lint && pnpm run knip && pnpm run i18n:check && pnpm run i18n:audit && pnpm run tokens:audit && pnpm run test:cov && pnpm run build && pnpm run budgets && pnpm run licenses:gen --check",
		"fonts:sync": "node scripts/sync-fonts.mjs",
		"licenses:gen": "node scripts/licenses-gen.mjs",
		"fixtures:music": "node scripts/gen-music-fixtures.mjs",
		"fixtures:media": "node scripts/gen-media-fixtures.mjs",
		"icons:gen": "node scripts/gen-icons.mjs",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
		"i18n:check": "node scripts/i18n-check.mjs",
		"i18n:audit": "node scripts/i18n-audit.mjs",
		"tokens:audit": "node scripts/tokens-audit.mjs",
		"test:cov": "vitest run --coverage"
	},
	"dependencies": {
		"dexie": "^4.4.7",
		"dompurify": "^3.4.17",
		"echarts": "^6.1.0",
		"fast-xml-parser": "^5.11.2",
		"gridstack": "^14.0.0",
		"maplibre-gl": "~6.12.0",
		"marked": "^18.1.1",
		"music-metadata": "^12.2.3",
		"qrcode-generator": "^2.0.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource/be-vietnam-pro": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@inlang/plugin-m-function-matcher": "^2.3.4",
		"@inlang/plugin-message-format": "^4.5.5",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"knip": "^6.42.1",
		"msw": "^3.0.3",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.152.0"
	}
}
