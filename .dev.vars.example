# Worker secrets, for `pnpm dev` and `pnpm preview` (doc 15 §6, doc 21 §4).
#
# Copy to `.dev.vars` and fill in. That file is gitignored; this one is not,
# and must never carry a real value.
#
# In production these are set with `wrangler secret put <NAME>` and appear
# nowhere in `wrangler.jsonc`, in CI logs, or in any client bundle — doc 21 §5
# greps the built output for them on every run.
#
# This file is also where their *types* come from. `pnpm gen` runs
# `wrangler types --env-file .dev.vars.example`, so the committed
# `worker-configuration.d.ts` is generated from these names on every machine
# and in CI alike — and a developer's real `.dev.vars` is never read by the
# generator. Add a secret here, then `pnpm gen`, or `pnpm lint` fails its
# `--check` (doc 11 §9).

# https://finnhub.io — free tier, 60 calls/min.
FINNHUB_KEY=

# https://twelvedata.com — free "Basic", 800 credits/day, resets 00:00 UTC.
TWELVEDATA_KEY=

# Any random string of at least 32 characters; shorter or empty turns the
# endpoint off. Gates GET /api/_health (doc 11 §9), sent as
# `Authorization: Bearer <token>` — never in a query string. The same bearer
# also passes the Turnstile gate, for curl and the S3 harness.
DEV_DASH_TOKEN=

# Cloudflare Turnstile's secret (doc 15 §3). Empty means no gate: /api/* is
# open, as on CI. To run the gate locally, use a testing pair instead of the
# real one. The testing secrets are 35 characters (`1x`, 31 zeros, `AA`); the
# sitekeys are 24. Checked against siteverify on 2026-09-23:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   TURNSTILE_SITE_KEY=1x00000000000000000000BB   (invisible, always passes)
# Swap the secret for 2x0000000000000000000000000000000AA to watch it fail, or
# the sitekey for 3x00000000000000000000FF to force the interactive dialog.
TURNSTILE_SECRET_KEY=
