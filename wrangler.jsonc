{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tilepier",
	// Must not exceed what the installed workerd binary supports, or local dev
	// refuses to start: "This Worker requires compatibility date 2026-08-10, but
	// the newest date supported by this server binary is 2026-08-08". `sv create`
	// stamps today's date, which outruns the shipped runtime. Raise this
	// together with a wrangler bump, not on its own.
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	// Edge cache + fx snapshots + soft rate-limit counters (doc 03 §Environment,
	// doc 11 §4-§7). Preview deploys point at the preview namespace so cache
	// experiments cannot pollute production (doc 21 §4).
	//
	// **The account is on Workers Paid** (confirmed 2026-08-30), and that is a
	// deployment fact rather than a billing one. On the free tier KV allows
	// 1 000 writes a day, and `_lib/ratelimit.ts` spends one per `/api/*`
	// request carrying an address — so roughly a thousand API requests would
	// exhaust the day before a single cache write or fx snapshot. Paid removes
	// that ceiling and meters writes instead, which turns the limiter's write
	// from a wall into a cost line worth watching (doc 11 §7) and unblocks doc
	// 10 §3's permanent daily fx snapshot.
	//
	// Not the same thing as the *zone* plan doc 11 §7 names for its one free
	// WAF rate-limiting rule. That is a different dimension and unchanged.
	"kv_namespaces": [
		{
			"binding": "TILEPIER_CACHE",
			"id": "1671381563ef4298997455c72f966db7",
			"preview_id": "5e6dc952b15c45bd85b90f9941b55cf1"
		}
	],

	// Off so the app has exactly one origin. A second reachable hostname would
	// be indexable, would sit outside the tilepier.win zone's rules, and would
	// give the legal gate and HSTS a second front door nobody audits.
	"workers_dev": false,
	"preview_urls": true,

	// Worker logs and traces, on so the ~6 % HTTP 500 at high concurrency
	// recorded in doc 22 §S3 can be diagnosed from the Worker's own side
	// rather than inferred from response codes. doc 11 §9 rules out
	// third-party telemetry; this is Cloudflare's built-in observability, which
	// stores no user identifiers.
	//
	// Note the shipped wrangler config-schema.json has no `observability` key —
	// the schema lags the feature, so editor autocomplete will flag this even
	// though `wrangler deploy` accepts it.
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	}

	// Secrets FINNHUB_KEY and TWELVEDATA_KEY are set with `wrangler secret put`
	// and never appear here or in CI logs (doc 15 §6, doc 21 §4).
}
